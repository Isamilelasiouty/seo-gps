# ==========================================
# SEO GPS Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to git!

# ------------------------------------------
# Branding & App Config
# ------------------------------------------
PRODUCT_NAME="SEO GPS"
BRAND_OWNER="Ismail El Asiouty"
FRONTEND_URL="https://isamilelasiouty.github.io/seo-gps"

# ------------------------------------------
# Supabase Configuration (Free Tier)
# ------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# ------------------------------------------
# Email Provider (Resend Free Tier recommended)
# ------------------------------------------
# Find API key in https://resend.com/api-keys
RESEND_API_KEY="re_123456789abcdef..."
EMAIL_FROM="SEO GPS <onboarding@resend.dev>"

# ------------------------------------------
# Crawler Engine Safeguards
# ------------------------------------------
CRAWL_MAX_PAGES_PER_PROJECT=2000
CRAWL_CONCURRENCY=5
CRAWL_POLITE_DELAY_MS=250
CRAWL_TIMEOUT_SECONDS=25
USER_AGENT="SEOGPS-Bot/1.0 (+https://isamilelasiouty.github.io/seo-gps/bot-info; by Ismail El Asiouty)"
